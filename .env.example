# ----- Supabase / Postgres -----
# Get these from Supabase: Project Settings -> Database -> Connection string.
# Most new projects no longer support the direct `db.PROJECT.supabase.co` host;
# use the Supavisor pooler hosts below.
#
# DATABASE_URL: use the SESSION pooler (port 5432) for running migrations
#   (long-lived connections, supports prepared statements).
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ----- Supabase Auth / data access -----
# Project URL (Settings -> API). Public.
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# Publishable (anon) key — public, ships to the browser. Respects RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role — SERVER ONLY. Never expose to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ----- AI service -----
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SHARED_SECRET=replace-with-a-long-random-string

# ----- LLM providers -----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_TUTOR=claude-sonnet-4-6
ANTHROPIC_MODEL_CHEAP=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_CURRICULUM=claude-sonnet-4-6

# ----- Free tier policy -----
FREE_TIER_TOKENS_PER_MONTH=100000

# ----- Curated courses: object storage (optional) -----
# Cloudflare R2, used only by the `ingest-course` CLI to store original
# lecture/assignment PDFs for provenance. Free tier covers this easily (10GB
# storage, egress always free). If unset, ingestion still works — it just
# skips the upload and curated_lecture_sources.original_pdf_path stays null.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=questlogic-curated
R2_PUBLIC_BASE_URL=
